# Kopier til .env på serveren.

# Hoveddomenet. Kunder får <slug>.BASE_DOMAIN.
BASE_DOMAIN=flatr.no
PUBLIC_PROTOCOL=https

# Hvor ofte SSE-strømmen sjekker etter endringer (ms).
SSE_POLL_MS=3000

# E-post. I docker-compose går den til den lokale Postfix-containeren «mail».
# Uten SMTP_HOST logges e-postene til konsollen.
SMTP_HOST=mail
SMTP_PORT=587
SMTP_TLS_VERIFY=false
MAIL_FROM=Flatr <noreply@flatr.no>

# Konvertering av dokumenter/nettsider (Gotenberg-containeren i docker-compose).
CONVERTER_URL=http://converter:3000

# Superadmin (flatr.no/superadmin) – kommaseparerte e-postadresser.
SUPERADMIN_EMAILS=

# Testkonto for App Store-gjennomgangen: får dette passordet i Better Auth
# ved oppstart hvis den ikke har passord fra før.
REVIEW_EMAIL=
REVIEW_PASSWORD=

# Flatr Apps: nøkkel som krypterer kundenes API-hemmeligheter (f.eks. BarentsWatch).
# Lag en lang tilfeldig streng én gang (openssl rand -base64 32) og ikke bytt den –
# da må alle hemmeligheter legges inn på nytt.
APPS_SECRET_KEY=

# Gratisplanen – samme som på flatr.no (kan overstyres pr. konto i superadmin).
BETA_STORAGE_MB=2048
BETA_MAX_DEVICES=1
BETA_MAX_SCREENS=1

# Better Auth (innlogging, passord, tofaktor). Lang tilfeldig streng
# (openssl rand -base64 32). MÅ ALDRI BYTTES – da slutter alle økter og
# tofaktor-oppsett å virke.
BETTER_AUTH_SECRET=
