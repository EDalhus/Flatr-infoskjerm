# Kopier til .env på serveren.

# Hoveddomenet. Kunder får <slug>.BASE_DOMAIN.
BASE_DOMAIN=flatr.no
PUBLIC_PROTOCOL=https

# Hvor ofte SSE-strømmen sjekker etter endringer (ms).
SSE_POLL_MS=3000

# E-post. I docker-compose går den til den lokale Postfix-containeren «mail».
# Uten SMTP_HOST logges e-postene til konsollen.
SMTP_HOST=mail
SMTP_PORT=587
SMTP_TLS_VERIFY=false
MAIL_FROM=Flatr <noreply@flatr.no>

# Konvertering av dokumenter/nettsider (Gotenberg-containeren i docker-compose).
CONVERTER_URL=http://converter:3000
