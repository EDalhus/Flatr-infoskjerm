{
  "name": "event-infoscreen",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Infoskjerm-plattform: landingsside + kontoer med egne subdomener. Kjører på egen server (Node + SQLite) eller som Cloudflare Worker.",
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "dev:client": "vite",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:create": "wrangler d1 create event-infoscreen-db",
    "db:local": "wrangler d1 execute event-infoscreen-db --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute event-infoscreen-db --remote --file=./schema.sql",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev:server": "npm run build && node --disable-warning=ExperimentalWarning server/index.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "nodemailer": "^7.0.13",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8",
    "wrangler": "^4.127.1"
  },
  "engines": {
    "node": ">=22.13"
  }
}
